{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf node_modules .next out",
    "dev": "next dev --port 9614",
    "start": "next start",
    "format": "prettier --ignore-path ../.prettierignore --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.3",
    "@number-flow/react": "0.6.2",
    "@number-flow/vue": "0.5.2",
    "@oztix/roadie-components": "workspace:*",
    "@oztix/roadie-core": "workspace:*",
    "@oztix/roadie-widgets": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@phosphor-icons/vue": "2.2.1",
    "@tanstack/react-query": "5.102.8",
    "@types/mdx": "2.0.14",
    "focus-trap": "8.2.2",
    "motion": "13.1.1",
    "next": "16.3.3",
    "next-view-transitions": "0.3.5",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-focus-lock": "2.13.7",
    "react-live": "4.1.8",
    "remark-gfm": "4.0.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-mdx": "3.8.1",
    "react-docgen-typescript": "2.4.0",
    "rehype-slug": "6.0.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0"
  }
}
