{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @oztix/roadie-core generate:tokens",
    "build": "next build && pnpm generate:llms",
    "generate:llms": "node scripts/llms.ts",
    "clean": "rm -rf node_modules .next out",
    "predev": "pnpm --filter @oztix/roadie-core generate:tokens",
    "dev": "next dev --port 9614",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=warn . && eslint \"**/*.{md,mdx}\"",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=warn --fix . && eslint \"**/*.{md,mdx}\" --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "@number-flow/react": "0.6.2",
    "@number-flow/vue": "0.5.2",
    "@oztix/roadie-charts": "workspace:*",
    "@oztix/roadie-components": "workspace:*",
    "@oztix/roadie-core": "workspace:*",
    "@oztix/roadie-editor": "workspace:*",
    "@oztix/roadie-widgets": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@phosphor-icons/vue": "2.2.1",
    "@tanstack/react-query": "5.105.0",
    "@types/mdx": "2.0.14",
    "colorjs.io": "0.7.1",
    "focus-trap": "8.2.4",
    "motion": "14.7.1",
    "next": "16.4.3",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-focus-lock": "2.13.7",
    "react-live": "5.0.1",
    "remark-gfm": "4.0.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@oztix/roadie-lint-plugin": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-mdx": "3.8.2",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-to-string": "4.0.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "rehype-slug": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
