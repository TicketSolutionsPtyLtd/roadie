{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["$TURBO_EXTENDS$", "NEXT_PUBLIC_BASE_PATH", "DOCS_GIT_HISTORY"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "src/content/**/*.md",
        "$TURBO_ROOT$/.changeset/*.md",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/lint-plugin/{oxlint,src}/**"
      ]
    },
    "lint:fix": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/lint-plugin/{oxlint,src}/**"
      ]
    }
  }
}
