{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["$TURBO_EXTENDS$", "NEXT_PUBLIC_BASE_PATH", "DOCS_GIT_HISTORY"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "src/content/**/*.md",
        "$TURBO_ROOT$/.changeset/*.md",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md",
        "public/**",
        "$TURBO_ROOT$/packages/blocks/src/thumbnails/**",
        "!src/**/{testUtils,*TestUtils}.{ts,tsx}",
        "!src/**/fixtures.{ts,tsx}"
      ],
      "outputs": ["out/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/eslint/**",
        "$TURBO_ROOT$/packages/lint-plugin/{oxlint,src}/**"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint/**",
        "$TURBO_ROOT$/packages/core/src/css/*.css",
        "$TURBO_ROOT$/packages/lint-plugin/{oxlint,src}/**"
      ]
    },
    "lint:fix": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint/**",
        "$TURBO_ROOT$/packages/core/src/css/*.css",
        "$TURBO_ROOT$/packages/lint-plugin/{oxlint,src}/**"
      ]
    }
  }
}
