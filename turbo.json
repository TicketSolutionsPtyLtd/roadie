{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "pnpm-lock.yaml", ".nvmrc"],
  "tasks": {
    "prepare": {
      "dependsOn": ["^build"],
      "inputs": ["package.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx,css,json}",
        "src/**/*.html",
        "*.config.{js,mjs,cjs,ts}",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "!.next/**/*.map"
      ]
    },
    "build:quiet": {
      "dependsOn": ["^build:quiet"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx,css,json}",
        "src/**/*.html",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "tsconfig.json",
        "!**/*.test.{ts,tsx}",
        "!**/roadie-core/**",
        "!**/styled-system/**"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx}",
        "eslint.config.js",
        "$TURBO_ROOT$/eslint.config.js",
        "package.json"
      ],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx}",
        "eslint.config.js",
        "$TURBO_ROOT$/eslint.config.js",
        "package.json"
      ],
      "outputs": ["src/**/*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx}",
        "**/*.test.{js,jsx,ts,tsx}",
        "jest.config.*",
        "*.config.{js,mjs,cjs,ts}",
        "package.json"
      ],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{js,jsx,ts,tsx,css}",
        "*.config.{js,mjs,cjs,ts}",
        "*.css",
        "package.json"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build:quiet"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["**/*.{js,jsx,ts,tsx,md,mdx,json,css}"],
      "outputs": []
    }
  }
}
