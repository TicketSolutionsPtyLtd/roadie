{
  "name": "roadie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": "^24.21.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:browser": "turbo test:browser",
    "test:gated": "node scripts/test-gated.mjs",
    "preview": "node scripts/preview.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "clean": "turbo clean && rm -rf node_modules",
    "clean:cache": "rm -rf .turbo/cache && pnpm store prune",
    "prune:cache": "find .turbo/cache -type f -mtime +14 -delete 2>/dev/null; true",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-plugin-version.mjs",
    "changeset:publish": "changeset publish",
    "prepare": "node scripts/prepare.mjs",
    "postinstall": "husky",
    "typecheck": "turbo typecheck",
    "release": "pnpm build && pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@oztix/roadie-lint-plugin": "workspace:*",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "oxlint --fix --no-error-on-unmatched-pattern",
    "docs/**/*.{md,mdx}": "eslint --no-warn-ignored",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
