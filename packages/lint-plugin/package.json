{
  "name": "@oztix/roadie-lint-plugin",
  "version": "0.1.1",
  "description": "Lint rules that catch Roadie Design System mistakes in apps, for ESLint and oxlint",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie",
    "directory": "packages/lint-plugin"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/",
  "bugs": "https://github.com/TicketSolutionsPtyLtd/roadie/issues",
  "license": "ISC",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "oxlint",
    "oxlint-plugin",
    "roadie"
  ],
  "exports": {
    ".": "./src/index.js",
    "./oxlint/*.json": "./oxlint/*.json"
  },
  "files": [
    "src",
    "oxlint",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "oxlint": "^1.88.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.5",
    "eslint-v10": "npm:eslint@10.12.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
