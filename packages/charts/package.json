{
  "name": "@oztix/roadie-charts",
  "version": "0.0.0",
  "description": "Roadie chart and dashboard composition for Oztix apps",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "Luke Brooker",
    "email": "mail@lukebrooker.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie",
    "directory": "packages/charts"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/charts",
  "files": [
    "dist",
    "src/css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "style": "./src/css/charts.css",
      "default": "./src/css/charts.css"
    },
    "./bar-chart": {
      "types": "./dist/BarChart/index.d.ts",
      "import": "./dist/BarChart/index.js"
    },
    "./chart": {
      "types": "./dist/Chart/index.d.ts",
      "import": "./dist/Chart/index.js"
    },
    "./chart-legend": {
      "types": "./dist/ChartLegend/index.d.ts",
      "import": "./dist/ChartLegend/index.js"
    },
    "./chart-patterns": {
      "types": "./dist/ChartPatterns/index.d.ts",
      "import": "./dist/ChartPatterns/index.js"
    },
    "./chart-tooltip": {
      "types": "./dist/ChartTooltip/index.d.ts",
      "import": "./dist/ChartTooltip/index.js"
    },
    "./dashboard-view": {
      "types": "./dist/DashboardView/index.d.ts",
      "import": "./dist/DashboardView/index.js"
    },
    "./funnel": {
      "types": "./dist/Funnel/index.d.ts",
      "import": "./dist/Funnel/index.js"
    },
    "./heatmap": {
      "types": "./dist/Heatmap/index.d.ts",
      "import": "./dist/Heatmap/index.js"
    },
    "./histogram": {
      "types": "./dist/Histogram/index.d.ts",
      "import": "./dist/Histogram/index.js"
    },
    "./line-chart": {
      "types": "./dist/LineChart/index.d.ts",
      "import": "./dist/LineChart/index.js"
    },
    "./ranked-bars": {
      "types": "./dist/RankedBars/index.d.ts",
      "import": "./dist/RankedBars/index.js"
    },
    "./scatter": {
      "types": "./dist/Scatter/index.d.ts",
      "import": "./dist/Scatter/index.js"
    },
    "./small-multiples": {
      "types": "./dist/SmallMultiples/index.d.ts",
      "import": "./dist/SmallMultiples/index.js"
    },
    "./stacked-bars": {
      "types": "./dist/StackedBars/index.d.ts",
      "import": "./dist/StackedBars/index.js"
    },
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "import": "./dist/examples/index.js"
    },
    "./static": {
      "types": "./dist/static/index.d.ts",
      "import": "./dist/static/index.js"
    },
    "./tables": {
      "types": "./dist/tables/index.d.ts",
      "import": "./dist/tables/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate:exports && tsdown && pnpm check:dts && pnpm check:exports",
    "generate:exports": "node scripts/generate-package-exports.mjs",
    "check:dts": "node scripts/check-dts.mjs",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints css",
    "dev": "tsdown --watch --log-level warn",
    "test": "vitest run --project jsdom",
    "test:browser": "vitest run --project 'browser (*)'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "dependencies": {
    "@oztix/roadie-core": "workspace:*",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-charts": "0.18.0"
  },
  "peerDependencies": {
    "@oztix/roadie-components": "workspace:^",
    "@phosphor-icons/react": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@oztix/roadie-components": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/preset-small-lib": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "14.0.0",
    "tsdown": "0.23.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "turbo": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
