  "sideEffects": false,
  "files": [
    "dist",
    "src/css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm generate:exports && tsdown && pnpm check:dts && pnpm check:exports",
    "build:quiet": "pnpm generate:exports && tsdown --log-level warn",
    "generate:exports": "node scripts/generate-package-exports.mjs",
    "check:dts": "node scripts/check-dts.mjs",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints css",
    "build:spotillustration": "node scripts/svg-to-spot-illustration.cjs",
    "clean": "rm -rf node_modules dist",
    "dev": "tsdown --watch --log-level warn",
    "test": "vitest run --project jsdom",
    "test:browser": "vitest run --project 'browser (*)'",
    "test:watch": "vitest --project jsdom",
    "test:coverage": "vitest run --project jsdom --coverage",
    "test:ui": "vitest --ui --project jsdom",
    "format": "prettier --ignore-path ../../.prettierignore --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.0.0",
