{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/docs/src/app/**/page.mdx",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.react.json",
        "!src/**/{testUtils,*TestUtils}.{ts,tsx}",
        "!src/**/*.ssr.tsx"
      ]
    },
    "build:quiet": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/docs/src/app/**/page.mdx",
        "$TURBO_ROOT$/packages/core/scripts/manifest/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.react.json",
        "!src/**/{testUtils,*TestUtils}.{ts,tsx}",
        "!src/**/*.ssr.tsx",
        "!$TURBO_ROOT$/packages/core/scripts/manifest/**/*.test.*"
      ]
    },
    "test:browser": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/{blocks,charts,editor,widgets}/src/**/*.{ts,tsx,css,vue,html,svg}"
      ]
    }
  }
}
