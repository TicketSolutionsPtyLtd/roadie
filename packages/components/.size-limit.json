[
  {
    "name": "All components (tree-shakeable index)",
    "path": "dist/index.js",
    "import": "*",
    "limit": "120.5 kB"
  },
  {
    "name": "Single component (Button)",
    "path": "dist/index.js",
    "import": "{ Button }",
    "limit": "2.5 kB",
    "ignore": ["@oztix/roadie-core"]
  },
  {
    "name": "Navigator",
    "path": "dist/components/Navigator/index.js",
    "import": "*",
    "limit": "38 kB",
    "ignore": ["@oztix/roadie-core"]
  },
  {
    "name": "Pane",
    "path": "dist/components/Pane/index.js",
    "import": "*",
    "limit": "12 kB",
    "ignore": ["@oztix/roadie-core"]
  },
  {
    "name": "Carousel",
    "path": "dist/components/Carousel/index.js",
    "limit": "8.5 kB",
    "ignore": [
      "react",
      "react-dom",
      "@oztix/roadie-core",
      "@phosphor-icons/react",
      "embla-carousel",
      "embla-carousel-react",
      "embla-carousel-autoplay"
    ]
  },
  {
    "name": "SpotIllustrations",
