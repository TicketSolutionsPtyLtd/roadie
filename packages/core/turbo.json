{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["$TURBO_EXTENDS$", "src/tokens/tokens.json"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "!src/tokens/tokens.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.react.json",
        "!src/**/{testUtils,*TestUtils}.{ts,tsx}",
        "!src/**/fixtures.{ts,tsx}"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_EXTENDS$", "scripts/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/eslint/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "scripts/**",
        "$TURBO_ROOT$/packages/lint-plugin/oxlint/**",
        "$TURBO_ROOT$/packages/lint-plugin/src/**",
        "$TURBO_ROOT$/skills/audit/**",
        "$TURBO_ROOT$/skills/*/codemods/**"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "scripts/manifest/*.{ts,json}"]
    },
    "build:quiet": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "!src/**/{testUtils,*TestUtils}.{ts,tsx}",
        "!src/**/fixtures.{ts,tsx}"
      ]
    }
  }
}
