{
  "name": "@oztix/roadie-core",
  "version": "2.11.0",
  "description": "Design tokens, CSS foundation, and utilities for the Roadie Design System",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "style": "./src/css/roadie.css",
      "default": "./src/css/roadie.css"
    },
    "./css/compiled": "./dist/roadie.compiled.css",
    "./colors": {
      "types": "./dist/colors/index.d.ts",
      "import": "./dist/colors/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./navigator": {
      "types": "./dist/navigator/index.d.ts",
      "import": "./dist/navigator/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "import": "./dist/datetime/index.js"
    },
    "./dataviz": {
      "types": "./dist/dataviz/index.d.ts",
      "import": "./dist/dataviz/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./dashboard-layout": {
      "types": "./dist/dashboard-layout/index.d.ts",
      "import": "./dist/dashboard-layout/index.js"
    },
    "./records": {
      "types": "./dist/records/index.d.ts",
      "import": "./dist/records/index.js"
    },
    "./records/meilisearch": {
      "types": "./dist/records/meilisearch/index.d.ts",
      "import": "./dist/records/meilisearch/index.js"
    },
    "./roadie.manifest.json": "./dist/roadie.manifest.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "!src/css/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "build": "pnpm generate:tokens && tsdown && pnpm build:css && pnpm generate:manifest",
    "build:quiet": "tsdown --log-level warn && pnpm build:css",
    "build:css": "tailwindcss -i src/css/roadie.css -o dist/roadie.compiled.css --content 'src/css/safelist.html'",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:manifest": "node scripts/manifest/generate.ts --tokens",
    "dev": "tsdown --watch --log-level warn",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "format": "prettier --ignore-path ../../.prettierignore --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}\"",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts/manifest",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "author": {
    "name": "Luke Brooker",
    "email": "mail@lukebrooker.com"
  },
  "license": "ISC",
  "dependencies": {
    "clsx": "2.1.1",
    "colorjs.io": "0.7.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "14.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "chokidar-cli": "3.0.0",
    "github-slugger": "2.0.0",
    "jscodeshift": "17.4.0",
    "react-docgen-typescript": "2.4.0",
    "size-limit": "14.1.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "size-limit": [
    {
      "name": "datetime",
      "path": "dist/datetime/index.js",
      "limit": "8.5 KB"
    },
    {
      "name": "records",
      "path": "dist/records/index.js",
      "limit": "37.5 KB"
    },
    {
      "name": "records without validation",
      "path": "dist/records/index.js",
      "import": "{ matchesRecordQuery, resolveRecordQuery, parseQuery, toSearchParams, equalViews }",
      "limit": "12.2 KB"
    },
    {
      "name": "records/meilisearch",
      "path": "dist/records/meilisearch/index.js",
      "limit": "4.9 KB"
    },
    {
      "name": "theme",
      "path": "dist/theme/index.js",
      "limit": "1.3 KB"
    }
  ]
}
