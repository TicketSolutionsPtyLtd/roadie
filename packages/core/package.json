{
  "name": "@oztix/roadie-core",
  "version": "2.13.0",
  "description": "Foundations of the Roadie Design System: CSS tokens and utilities, plus framework-agnostic logic for records, dates and times, the colour generator, and dashboards",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "style": "./src/css/roadie.css",
      "default": "./src/css/roadie.css"
    },
    "./css/compiled": "./dist/roadie.compiled.css",
    "./colors": {
      "types": "./dist/colors/index.d.ts",
      "import": "./dist/colors/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./navigator": {
      "types": "./dist/navigator/index.d.ts",
      "import": "./dist/navigator/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "import": "./dist/datetime/index.js"
    },
    "./number": {
      "types": "./dist/number/index.d.ts",
      "import": "./dist/number/index.js"
    },
    "./dataviz": {
      "types": "./dist/dataviz/index.d.ts",
      "import": "./dist/dataviz/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./dashboard-layout": {
      "types": "./dist/dashboard-layout/index.d.ts",
      "import": "./dist/dashboard-layout/index.js"
    },
    "./records": {
      "types": "./dist/records/index.d.ts",
      "import": "./dist/records/index.js"
    },
    "./records/meilisearch": {
      "types": "./dist/records/meilisearch/index.d.ts",
      "import": "./dist/records/meilisearch/index.js"
    },
    "./records/elasticsearch": {
      "types": "./dist/records/elasticsearch/index.d.ts",
      "import": "./dist/records/elasticsearch/index.js"
    },
    "./records/json-schema": {
      "types": "./dist/records/json-schema/index.d.ts",
      "import": "./dist/records/json-schema/index.js"
    },
    "./records/record-view.schema.json": "./dist/records/record-view.schema.json",
    "./records/records-request.schema.json": "./dist/records/records-request.schema.json",
    "./roadie.manifest.json": "./dist/roadie.manifest.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "!src/css/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "build": "pnpm generate:tokens && tsdown && node scripts/records-json-schema.mjs && pnpm build:css && pnpm generate:manifest",
    "build:quiet": "tsdown --log-level warn && node scripts/records-json-schema.mjs && pnpm build:css",
    "build:css": "tailwindcss -i src/css/roadie.css -o dist/roadie.compiled.css --content 'src/css/safelist.html'",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:manifest": "node scripts/manifest/generate.ts --tokens",
    "dev": "tsdown --watch --log-level warn",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "lint:fix": "oxlint . --fix",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts/manifest",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "author": {
    "name": "Luke Brooker",
    "email": "mail@lukebrooker.com"
  },
  "license": "ISC",
  "dependencies": {
    "clsx": "2.1.1",
    "colorjs.io": "0.7.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "14.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "chokidar-cli": "3.0.0",
    "github-slugger": "2.0.0",
    "jscodeshift": "17.4.0",
    "react-docgen-typescript": "2.4.0",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "size-limit": [
    {
      "name": "datetime",
      "path": "dist/datetime/index.js",
      "limit": "9.7 KB"
    },
    {
      "name": "datetime formatting only",
      "path": "dist/datetime/index.js",
      "import": "{ formatDateTime, formatDateRange, formatRelative, formatDuration }",
      "limit": "2.25 KB"
    },
    {
      "name": "number",
      "path": "dist/number/index.js",
      "limit": "500 B"
    },
    {
      "name": "records",
      "path": "dist/records/index.js",
      "limit": "44.5 KB"
    },
    {
      "name": "records without validation",
      "path": "dist/records/index.js",
      "import": "{ matchesRecordQuery, resolveRecordQuery, parseRecordQuery, recordViewToSearchParams, equalRecordViews }",
      "limit": "15.8 KB"
    },
    {
      "name": "records/json-schema",
      "path": "dist/records/json-schema/index.js",
      "limit": "27.3 KB"
    },
    {
      "name": "records/elasticsearch",
      "path": "dist/records/elasticsearch/index.js",
      "limit": "1.45 KB"
    },
    {
      "name": "records/meilisearch",
      "path": "dist/records/meilisearch/index.js",
      "limit": "1.65 KB"
    },
    {
      "name": "theme",
      "path": "dist/theme/index.js",
      "limit": "1.3 KB"
    }
  ]
}
