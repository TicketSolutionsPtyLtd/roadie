{
  "name": "@oztix/roadie-marketing-blocks",
  "version": "0.0.0",
  "description": "Designed marketing page blocks for Oztix sites, independent of any CMS",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "Luke Brooker",
    "email": "mail@lukebrooker.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie",
    "directory": "packages/marketing-blocks"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/blocks",
  "files": [
    "dist",
    "src/css",
    "src/thumbnails"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./css": {
      "style": "./src/css/marketing-blocks.css",
      "default": "./src/css/marketing-blocks.css"
    },
    "./provider": {
      "types": "./dist/Provider/index.d.ts",
      "import": "./dist/Provider/index.js"
    },
    "./split": {
      "types": "./dist/Split/index.d.ts",
      "import": "./dist/Split/index.js"
    },
    "./stats": {
      "types": "./dist/Stats/index.d.ts",
      "import": "./dist/Stats/index.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue/index.d.ts",
      "import": "./dist/catalogue/index.js"
    },
    "./thumbnails/*": "./src/thumbnails/*",
    "./roadie.manifest.json": "./dist/roadie.manifest.json"
  },
  "scripts": {
    "build": "pnpm generate:exports && tsdown && pnpm check:use-client && pnpm generate:manifest && pnpm check:dts && pnpm check:exports",
    "generate:exports": "node scripts/generate-package-exports.mjs",
    "generate:manifest": "node ../core/scripts/manifest/generate.ts",
    "check:dts": "node scripts/check-dts.mjs",
    "check:use-client": "node ../core/scripts/check-use-client.mjs",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints css roadie.manifest.json thumbnails/*",
    "dev": "tsdown --watch --log-level warn",
    "test": "vitest run --project jsdom",
    "test:browser": "vitest run --project 'browser (*)' ${ROADIE_SHARD:+--shard=$ROADIE_SHARD --passWithNoTests}",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "dependencies": {
    "@oztix/roadie-core": "workspace:*"
  },
  "peerDependencies": {
    "@oztix/roadie-components": "workspace:^",
    "@phosphor-icons/react": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@oztix/roadie-components": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/preset-small-lib": "14.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "turbo": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
