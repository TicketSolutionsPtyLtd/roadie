{
  "name": "@oztix/roadie-editor",
  "version": "0.2.0",
  "description": "Roadie rich-text editor and its saved format for Oztix apps",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "Luke Brooker",
    "email": "mail@lukebrooker.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/TicketSolutionsPtyLtd/roadie/tree/main/packages/editor",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "src/css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./css": {
      "style": "./src/css/editor.css",
      "default": "./src/css/editor.css"
    },
    "./editor": {
      "types": "./dist/Editor/index.d.ts",
      "import": "./dist/Editor/index.js"
    },
    "./email-html-field": {
      "types": "./dist/EmailHtmlField/index.d.ts",
      "import": "./dist/EmailHtmlField/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./roadie.manifest.json": "./dist/roadie.manifest.json"
  },
  "scripts": {
    "build:quiet": "pnpm generate:manifest --alongside tsdown --log-level warn",
    "build": "pnpm generate:manifest --alongside tsdown && pnpm check:use-client",
    "check:package": "pnpm check:exports && pnpm check:pack",
    "generate:manifest": "node ../core/scripts/manifest/generate.ts",
    "check:use-client": "node ../core/scripts/check-use-client.mjs",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints css roadie.manifest.json",
    "check:pack": "node ../core/scripts/check-pack.mjs",
    "dev": "tsdown --watch --log-level warn",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project 'browser (*)' ${ROADIE_SHARD:+--shard=$ROADIE_SHARD --passWithNoTests}",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "size:check": "size-limit --limit"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-heading": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-typography": "3.33.0",
    "@tiptap/extension-unique-id": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/static-renderer": "3.33.0",
    "@tiptap/suggestion": "3.33.0",
    "html-to-text": "10.0.1",
    "mjml": "5.4.1"
  },
  "peerDependencies": {
    "@oztix/roadie-components": "workspace:^",
    "@oztix/roadie-core": "workspace:^",
    "@phosphor-icons/react": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@oztix/roadie-components": "workspace:*",
    "@oztix/roadie-core": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@rolldown/plugin-babel": "0.3.0",
    "@size-limit/preset-small-lib": "14.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.5",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "turbo": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
