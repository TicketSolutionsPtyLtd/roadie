exports[`renderEmail > each node > renders a button as a link in the theme’s colours, its label as text 1`] = `
"<body  style="word-spacing:normal;background-color:#ffffff;">
        
        <div
           aria-roledescription="email" role="article" lang="und" dir="auto" style="word-spacing:normal;background-color:#ffffff;"
        >
        
      
