{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest", "node"]
  },
  "include": ["src"],
  // Browser tests bring vitest/browser's matchers, which clash with jest-dom's.
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.browser.test.*",
    "src/cart-drawer/drawerTestUtils.ts"
  ]
}
