{
  "name": "@oztix/roadie-eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules that catch Roadie Design System mistakes in apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TicketSolutionsPtyLtd/roadie",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://ticketsolutionsptyltd.github.io/roadie/",
  "bugs": "https://github.com/TicketSolutionsPtyLtd/roadie/issues",
  "license": "ISC",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "roadie"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"**/*.{js,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.39.5",
    "eslint-v10": "npm:eslint@10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
